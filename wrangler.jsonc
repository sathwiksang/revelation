{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revstudy",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash", "run_worker_first": true },
  // Workers Custom Domains: Cloudflare creates the DNS records and certificates for them.
  // rev. is the short address; the Worker forwards it to revstudy.
  "routes": [
    { "pattern": "revstudy.sathwiksangeetham.com", "custom_domain": true },
    { "pattern": "rev.sathwiksangeetham.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "workers_dev": false
}
