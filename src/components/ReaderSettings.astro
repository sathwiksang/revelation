---
/**
 * Reading settings: text size, typeface, line spacing, line length, paper, justified text,
 * note numbers and a focus mode. A native popover (it opens without script); the choices are
 * applied and kept in this browser by src/scripts/reader.ts, and set again before the first
 * paint by the small script in Base.astro.
 */
const sizes = [
  { v: '-2', name: 'Smallest', em: 0.78 },
  { v: '-1', name: 'Small', em: 0.88 },
  { v: '0', name: 'Standard', em: 1 },
  { v: '1', name: 'Large', em: 1.12 },
  { v: '2', name: 'Larger', em: 1.24 },
  { v: '3', name: 'Largest', em: 1.36 },
];
const faces = [
  { v: 'garamond', name: 'Garamond', note: 'The book’s own' },
  { v: 'literata', name: 'Literata', note: 'Made for screens' },
  { v: 'atkinson', name: 'Atkinson', note: 'Clearest letters' },
];
const leads = [
  { v: 'compact', name: 'Compact' },
  { v: 'normal', name: 'Comfortable' },
  { v: 'airy', name: 'Airy' },
];
const measures = [
  { v: 'narrow', name: 'Narrow' },
  { v: 'normal', name: 'Medium' },
  { v: 'wide', name: 'Wide' },
];
const papers = [
  { v: 'vellum', name: 'Vellum' },
  { v: 'white', name: 'White' },
  { v: 'sepia', name: 'Parchment' },
];
---
<div id="reader-settings" popover class="settings" role="dialog" aria-labelledby="rs-title">
  <div class="s-head">
    <h2 id="rs-title">Reading settings</h2>
    <button type="button" class="close" popovertarget="reader-settings" popovertargetaction="hide" aria-label="Close reading settings">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3 3 13" stroke="currentColor" stroke-width="1.4" /></svg>
    </button>
  </div>

  <form class="s-form" data-reader-form>
    <fieldset>
      <legend>Text size</legend>
      <div class="seg six">
        {sizes.map((s) => (
          <label title={s.name}>
            <input type="radio" name="size" value={s.v} checked={s.v === '0'} />
            <span class="a" aria-hidden="true" style={`font-size:${s.em}em`}>A</span>
            <span class="sr">{s.name}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset>
      <legend>Typeface</legend>
      <div class="faces">
        {faces.map((f) => (
          <label class={`face ${f.v}`}>
            <input type="radio" name="face" value={f.v} checked={f.v === 'garamond'} />
            <span class="sample" aria-hidden="true">Aa</span>
            <span class="fname">{f.name}</span>
            <span class="fnote">{f.note}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset>
      <legend>Line spacing</legend>
      <div class="seg three">
        {leads.map((l) => (
          <label>
            <input type="radio" name="lead" value={l.v} checked={l.v === 'normal'} />
            <svg class={`lines ${l.v}`} width="22" height="18" viewBox="0 0 22 18" aria-hidden="true">
              {l.v === 'compact' && <path d="M2 4h18M2 8h18M2 12h18M2 16h12" />}
              {l.v === 'normal' && <path d="M2 3h18M2 9h18M2 15h12" />}
              {l.v === 'airy' && <path d="M2 2h18M2 10h18M2 18h12" />}
            </svg>
            <span class="lbl">{l.name}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="measure-set">
      <legend>Line length</legend>
      <div class="seg three">
        {measures.map((m) => (
          <label>
            <input type="radio" name="measure" value={m.v} checked={m.v === 'normal'} />
            <svg class="width" width="26" height="16" viewBox="0 0 26 16" aria-hidden="true">
              {m.v === 'narrow' && <path d="M8 3h10M8 8h10M8 13h7" />}
              {m.v === 'normal' && <path d="M5 3h16M5 8h16M5 13h11" />}
              {m.v === 'wide' && <path d="M1 3h24M1 8h24M1 13h16" />}
            </svg>
            <span class="lbl">{m.name}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset>
      <legend>Paper</legend>
      <div class="seg three papers">
        {papers.map((p) => (
          <label>
            <input type="radio" name="paper" value={p.v} checked={p.v === 'vellum'} />
            <span class={`swatch ${p.v}`} aria-hidden="true"></span>
            <span class="lbl">{p.name}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="switches">
      <label class="switch">
        <span><b>Justified text</b><small>Even right edge, with hyphens</small></span>
        <input type="checkbox" name="justify" value="on" role="switch" />
      </label>
      <label class="switch">
        <span><b>Note numbers</b><small>The study’s source numbers</small></span>
        <input type="checkbox" name="notes" value="on" role="switch" checked />
      </label>
      <label class="switch">
        <span><b>Focus</b><small>Only the text, nothing beside it</small></span>
        <input type="checkbox" name="focus" value="on" role="switch" />
      </label>
    </div>

    <div class="s-foot">
      <button type="button" class="reset" data-reader-reset>Restore the defaults</button>
      <p class="tip">Kept in this browser.<span class="keys"> <kbd>←</kbd> <kbd>→</kbd> turn the chapter.</span></p>
    </div>
  </form>
</div>

<style>
  .settings {
    position: fixed;
    inset: calc(var(--header-h) + 0.6rem) max(1rem, calc((100vw - 92rem) / 2 + var(--gutter))) auto auto;
    margin: 0;
    width: min(23rem, calc(100vw - 2rem));
    max-height: calc(100svh - var(--header-h) - 1.6rem);
    overflow: auto;
    overscroll-behavior: contain;
    padding: 1.2rem 1.25rem 1rem;
    border: 1px solid var(--hairline);
    border-radius: 20px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-2);
    font-family: var(--font-text);
    font-size: 1rem;
    line-height: 1.3;
    scrollbar-width: thin;
  }
  .settings::backdrop { background: transparent; }
  @media (max-width: 47.99rem) {
    .settings {
      inset: auto 0 0 0;
      width: 100%;
      max-height: 88svh;
      border-radius: 22px 22px 0 0;
      border-bottom: 0;
      padding: 0.9rem 1.15rem calc(1rem + env(safe-area-inset-bottom));
    }
    .settings::before {
      content: '';
      display: block;
      width: 2.6rem; height: 4px;
      margin: 0 auto 0.6rem;
      border-radius: 4px;
      background: var(--hairline-2);
    }
    .settings::backdrop { background: rgb(22 20 15 / 0.22); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .settings { transition: opacity 0.28s var(--ease), transform 0.28s var(--ease), display 0.28s allow-discrete, overlay 0.28s allow-discrete; }
    .settings:popover-open { opacity: 1; transform: none; }
    .settings:not(:popover-open) { opacity: 0; transform: translateY(-6px); }
    @starting-style { .settings:popover-open { opacity: 0; transform: translateY(-6px); } }
    @media (max-width: 47.99rem) {
      .settings:not(:popover-open) { transform: translateY(24px); }
      @starting-style { .settings:popover-open { transform: translateY(24px); } }
    }
  }

  .s-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem; }
  .s-head h2 { font-size: 1.45rem; font-weight: 500; }
  .close { background: none; border: 0; padding: 0.45rem; margin-right: -0.4rem; cursor: pointer; color: var(--ink-2); border-radius: 999px; }
  .close:hover { color: var(--ink); background: var(--vellum-2); }

  fieldset { border: 0; padding: 0; margin: 0 0 0.85rem; min-width: 0; }
  /* On a phone the text already fills the screen's width. */
  @media (max-width: 40rem) { .measure-set { display: none; } }
  legend {
    padding: 0;
    margin-bottom: 0.45rem;
    font-size: 0.82rem;
    font-weight: 600;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.14em;
    color: var(--ink-3);
  }
  input[type='radio'] { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }

  .seg {
    display: grid;
    gap: 3px;
    padding: 3px;
    border-radius: 12px;
    background: var(--vellum-2);
    border: 1px solid var(--hairline);
  }
  .seg.six { grid-template-columns: repeat(6, 1fr); }
  .seg.three { grid-template-columns: repeat(3, 1fr); }
  .seg label {
    position: relative;
    display: grid;
    place-items: center;
    gap: 0.2rem;
    min-height: 2.6rem;
    padding: 0.3rem 0.2rem;
    border-radius: 9px;
    cursor: pointer;
    color: var(--ink-2);
    transition: background 0.2s, color 0.2s, box-shadow 0.2s;
  }
  .seg label:hover { color: var(--ink); background: color-mix(in oklab, var(--paper) 55%, transparent); }
  .seg label:has(input:checked) { background: var(--paper); color: var(--ink); box-shadow: 0 1px 2px rgb(40 30 10 / 0.08), 0 2px 8px rgb(40 30 10 / 0.06); }
  .seg label:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 1px; }
  .seg .a { font-family: var(--font-display); font-weight: 500; font-size: 1.2rem; line-height: 1; font-size-adjust: none; }
  .seg.six .a { font-size: inherit; }
  .seg.six label { font-size: 1.25rem; }
  .seg .lbl { font-size: 0.8rem; line-height: 1.1; }
  .seg svg { stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; fill: none; }

  .faces { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .face {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 0.1rem;
    padding: 0.5rem 0.65rem 0.55rem;
    border: 1px solid var(--hairline);
    border-radius: 12px;
    cursor: pointer;
    background: var(--paper);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .face:hover { border-color: var(--hairline-2); }
  .face:has(input:checked) { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent) inset; }
  .face:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .face .sample { font-size: 1.7rem; line-height: 1.1; color: var(--ink); }
  .face.garamond .sample { font-family: var(--font-text); }
  .face.literata .sample { font-family: var(--ff-literata, 'Literata'), Georgia, serif; font-size: 1.5rem; }
  .face.atkinson .sample { font-family: var(--ff-atkinson, 'Atkinson Hyperlegible Next'), system-ui, sans-serif; font-size: 1.5rem; }
  .fname { font-size: 0.92rem; font-weight: 500; }
  .fnote { font-size: 0.74rem; color: var(--ink-3); line-height: 1.2; }

  .swatch { width: 1.5rem; height: 1.5rem; border-radius: 50%; border: 1px solid rgb(40 30 10 / 0.18); box-shadow: inset 0 1px 2px rgb(255 255 255 / 0.6); }
  .swatch.vellum { background: #f7f4ee; }
  .swatch.white { background: #ffffff; }
  .swatch.sepia { background: #f2e8d3; }

  .switches { display: grid; gap: 0.15rem; margin: 0.2rem 0 0.8rem; border-top: 1px solid var(--vellum-3); padding-top: 0.5rem; }
  .switch { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.38rem 0; cursor: pointer; }
  .switch b { display: block; font-weight: 500; font-size: 0.98rem; }
  .switch small { display: block; font-size: 0.78rem; color: var(--ink-3); margin-top: 0.05rem; }
  .switch input {
    appearance: none;
    flex: none;
    width: 2.6rem;
    height: 1.5rem;
    margin: 0;
    border-radius: 999px;
    background: var(--vellum-3);
    border: 1px solid var(--hairline-2);
    position: relative;
    cursor: pointer;
    transition: background 0.25s var(--ease), border-color 0.25s;
  }
  .switch input::after {
    content: '';
    position: absolute;
    top: 2px; left: 2px;
    width: calc(1.5rem - 6px);
    height: calc(1.5rem - 6px);
    border-radius: 50%;
    background: var(--paper);
    box-shadow: 0 1px 3px rgb(40 30 10 / 0.25);
    transition: transform 0.25s var(--ease);
  }
  .switch input:checked { background: var(--accent); border-color: var(--accent); }
  .switch input:checked::after { transform: translateX(1.1rem); }
  .switch input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .s-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; border-top: 1px solid var(--vellum-3); padding-top: 0.75rem; }
  .reset { font: inherit; font-size: 0.88rem; background: none; border: 0; padding: 0.3rem 0; color: var(--accent); cursor: pointer; text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--accent) 35%, transparent); text-underline-offset: 0.2em; }
  .reset:hover { text-decoration-color: currentColor; }
  .tip { font-size: 0.78rem; color: var(--ink-3); }
  kbd { font-family: var(--font-text); font-size: 0.78rem; padding: 0.05rem 0.35rem; border: 1px solid var(--hairline); border-radius: 5px; background: var(--vellum); }
  @media (hover: none) { .keys { display: none; } }
</style>
