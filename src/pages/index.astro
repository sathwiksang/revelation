---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { chapters, home, chaptersHeader } from '../lib/study';
import { loadFigures } from '../lib/figures';
import { PARTS } from '../lib/parts';
import { SITE } from '../site';
import { verseHtml, phrase, TRANSLATION } from '../lib/scripture';

const all = chapters(await loadFigures());
const timeline = all.find((c) => c.n === 0)!;
const byN = new Map(all.map((c) => [c.n, c]));
const words = all.reduce((s, c) => s + c.words, 0);
const sources = new Set(all.flatMap((c) => c.citations)).size;
const eyebrow = phrase(1, 1, 'Revelation of Jesus Christ');
// The study's own first two sentences (Revelation 1, Introduction).
const intro = byN.get(1)!.excerpt.split(/(?<=[.!?][”’]?)\s+(?=[A-Z“‘])/).slice(0, 2).join(' ');

const schema = [
  {
    '@type': 'Book',
    '@id': `${SITE.url}/#study`,
    name: SITE.name,
    alternateName: `${home.title}: ${home.subtitle}`,
    description: SITE.description,
    url: `${SITE.url}/`,
    author: { '@id': `${SITE.authorUrl}/#person` },
    inLanguage: 'en',
    bookFormat: 'https://schema.org/EBook',
    isAccessibleForFree: true,
    about: { '@type': 'Book', name: 'The Book of Revelation' },
    numberOfPages: all.length,
    hasPart: all.map((c) => ({ '@id': `${SITE.url}${c.href}#article` })),
  },
  {
    '@type': 'ItemList',
    name: chaptersHeader.heading,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: all.length,
    itemListElement: all.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE.url}${c.href}`,
      name: c.n === 0 ? c.heading : `Revelation ${c.n}: ${c.title}`,
    })),
  },
];
---
<Base title={SITE.title} description={SITE.description} schema={schema} image="/og/default.jpg" bodyClass="home">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-inner">
      <div class="door-wrap" aria-hidden="true">
        <div class="door">
          <div class="light"></div>
          <div class="rays"></div>
          <div class="bow"></div>
          <div class="sea"></div>
          <div class="frame"></div>
          <svg class="stars" viewBox="0 0 100 40">
            {[0, 1, 2, 3, 4, 5, 6].map((k) => {
              const t = k / 6, x = 22 + t * 56, y = 26 - Math.sin(t * Math.PI) * 13;
              return <path transform={`translate(${x.toFixed(2)} ${y.toFixed(2)}) scale(${k === 3 ? 0.085 : 0.065}) translate(-32 -32)`} d="M32 1 L33.61 28.12 L42.61 21.39 L35.88 30.39 L63 32 L35.88 33.61 L42.61 42.61 L33.61 35.88 L32 63 L30.39 35.88 L21.39 42.61 L28.12 33.61 L1 32 L28.12 30.39 L21.39 21.39 L30.39 28.12Z" style={`--k:${k}`} />;
            })}
          </svg>
        </div>
      </div>

      <div class="hero-words">
        <p class="eyebrow" data-reveal>{eyebrow}</p>
        <h1 id="hero-title" data-reveal style="--delay:.08s">{home.title}</h1>
        <p class="subtitle" data-reveal style="--delay:.16s">{home.subtitle}</p>
        <blockquote class="blessing" data-reveal style="--delay:.24s">
          <p set:html={verseHtml(1, 3)} />
          <footer>Revelation 1:3 · {TRANSLATION.abbreviation}</footer>
        </blockquote>
        <div class="actions" data-reveal style="--delay:.32s">
          <a class="btn" href="/revelation-1">{home.cta} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="text-link" href="#chapters">All 22 chapters</a>
        </div>
        <!-- Shown by the reader script when this browser has a place saved in a chapter. -->
        <a class="continue" href="/revelation-1" data-continue hidden>
          <span class="mark" aria-hidden="true"></span>
          <span class="cw">
            <span class="eyebrow">Continue reading</span>
            <span class="what" data-continue-what></span>
            <span class="where" data-continue-where></span>
          </span>
          <span class="go" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="numbers" aria-label="The study in numbers">
    <dl>
      <div data-reveal><dt>Chapters</dt><dd>22</dd></div>
      <div data-reveal style="--delay:.06s"><dt>Words of study</dt><dd>{Math.round(words / 1000).toLocaleString('en-US')},000+</dd></div>
      <div data-reveal style="--delay:.12s"><dt>Sources linked</dt><dd>{sources}</dd></div>
      <div data-reveal style="--delay:.18s"><dt>Prophetic timeline</dt><dd>1</dd></div>
    </dl>
  </section>

  <section id="chapters" class="chapters" aria-labelledby="chapters-title">
    <header class="chapters-head">
      <h2 id="chapters-title" data-reveal>{chaptersHeader.heading}</h2>
      <p data-reveal style="--delay:.08s">{chaptersHeader.subtitle}</p>
    </header>

    <a class="feature" href={timeline.href} data-reveal>
      <span class="f-num" aria-hidden="true"><Mark size={54} /></span>
      <span class="f-words">
        <span class="eyebrow">Chapter 00 · The prophetic timeline</span>
        <span class="f-title">{timeline.heading}</span>
        <span class="f-desc">{timeline.description}</span>
        <span class="f-meta">{timeline.minutes} min read · {timeline.toc.filter((t) => t.level === 2).length} stations</span>
      </span>
      <span class="f-go" aria-hidden="true">→</span>
    </a>

    <div class="outline" data-reveal>
      <p class="eyebrow">The book’s own outline</p>
      <blockquote>
        <p set:html={verseHtml(1, 19)} />
        <footer>Revelation 1:19 · {TRANSLATION.abbreviation}</footer>
      </blockquote>
    </div>

    {PARTS.map((part) => (
      <section class="part" aria-labelledby={`part-${part.key}`}>
        <header class="part-head" data-reveal>
          <span class="part-num" aria-hidden="true">{part.numeral}</span>
          <h3 id={`part-${part.key}`}><span class="sr">Part {part.numeral}: </span><span class="phrase">“{part.phrase}”</span></h3>
        </header>
        {part.groups.map((g) => (
          <div class="group" style={`--accent:${g.accent}`}>
            <h4 class="group-title" data-reveal><span class="swatch" aria-hidden="true"></span>{g.title}<span class="range">{g.chapters.length > 1 ? `Chapters ${g.chapters[0]}–${g.chapters.at(-1)}` : `Chapter ${g.chapters[0]}`}</span></h4>
            <ul class="cards">
              {g.chapters.map((n, k) => {
                const c = byN.get(n)!;
                return (
                  <li data-reveal style={`--delay:${(k * 0.06).toFixed(2)}s`}>
                    <a class="card" href={c.href}>
                      <span class="c-num" aria-hidden="true">{n}</span>
                      <span class="c-ref">Revelation {n}</span>
                      <span class="c-title">{c.title}</span>
                      <span class="c-desc">{c.description}</span>
                      <span class="c-meta">{c.minutes} min read</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </section>
    ))}
  </section>

  <section class="about" aria-labelledby="about-title">
    <div class="about-inner" data-reveal>
      <p class="eyebrow">About this study</p>
      <h2 id="about-title">Verse by verse, from the first chapter to the last</h2>
      <p class="from-study">“{intro}”</p>
      <a class="text-link" href="/revelation-1#introduction">Read the introduction to Revelation 1</a>
    </div>
  </section>
</Base>

<style>
  /* ── Hero: a door opened in heaven ─────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: clip;
    background:
      radial-gradient(70% 60% at 72% 30%, rgb(255 251 238 / 0.95), transparent 70%),
      radial-gradient(60% 60% at 20% 90%, color-mix(in oklab, var(--gold-light) 25%, transparent), transparent 70%),
      var(--vellum);
    border-bottom: 1px solid var(--hairline);
  }
  .hero-inner {
    max-width: 84rem;
    min-height: calc(100svh - var(--header-h));
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) var(--gutter) clamp(3rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .hero-words { grid-column: 1; grid-row: 1; }
  .door-wrap { grid-column: 2; grid-row: 1; display: grid; place-items: center; }
  @media (max-width: 52rem) {
    .hero-inner { grid-template-columns: minmax(0, 1fr); min-height: auto; padding-top: 1.5rem; gap: 1.2rem; }
    .door-wrap { grid-column: 1; grid-row: 1; }
    .hero-words { grid-row: 2; }
  }

  .door {
    position: relative;
    width: min(26rem, 72vw);
    aspect-ratio: 5 / 8;
  }
  @media (max-width: 52rem) { .door { width: min(10.5rem, 40vw); } }
  .door .frame, .door .light, .door .rays { position: absolute; inset: 0; border-radius: 50% 50% 0 0 / 31% 31% 0 0; }
  .door .frame {
    border: 1px solid var(--gold);
    border-bottom: 0;
    box-shadow: inset 0 0 0 10px color-mix(in oklab, var(--vellum) 60%, transparent), inset 0 0 0 11px color-mix(in oklab, var(--gold) 45%, transparent);
  }
  .door .light {
    background:
      radial-gradient(60% 45% at 50% 38%, #fffdf6 0%, rgb(255 248 228 / 0.9) 35%, transparent 75%),
      linear-gradient(180deg, #fbf3df 0%, #f3e6c4 55%, color-mix(in oklab, var(--gold-light) 70%, var(--vellum)) 100%);
    box-shadow: 0 30px 120px -20px rgb(217 192 138 / 0.65);
  }
  .door .rays {
    overflow: hidden;
    background: repeating-conic-gradient(from 0deg at 50% 36%, rgb(255 255 255 / 0.55) 0deg 2deg, transparent 2deg 9deg);
    mask-image: radial-gradient(70% 55% at 50% 36%, #000 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(70% 55% at 50% 36%, #000 0%, transparent 70%);
    opacity: 0.7;
  }
  /* Seven stars across the head of the arch (1:16, 20). */
  .stars { position: absolute; left: 0; top: 4%; width: 100%; overflow: visible; }
  .stars path { fill: var(--gold); }
  /* A rainbow round about the throne, like an emerald (4:3): a faint ring in the light. */
  .door .bow {
    position: absolute;
    left: 17%; right: 17%; top: 19%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgb(47 106 85 / 0.28);
    box-shadow: 0 0 34px rgb(47 106 85 / 0.12), inset 0 0 26px rgb(47 106 85 / 0.1);
  }
  /* A sea of glass like crystal (4:6): fine level lines, cool and clear, at the foot. */
  .door .sea {
    position: absolute;
    inset: auto 1px 0 1px;
    height: 24%;
    background:
      repeating-linear-gradient(180deg, rgb(255 255 255 / 0.65) 0 1px, transparent 1px 6px),
      linear-gradient(180deg, rgb(214 228 232 / 0), rgb(196 216 224 / 0.55));
    mask-image: linear-gradient(180deg, transparent, #000 45%);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 45%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .door .rays { animation: turn 120s linear infinite; }
    @keyframes turn { to { transform: rotate(360deg); } }
    .door .light { animation: breathe 9s ease-in-out infinite alternate; }
    @keyframes breathe { from { filter: brightness(1); } to { filter: brightness(1.05) saturate(1.05); } }
    .stars path { animation: twinkle 5s ease-in-out infinite; animation-delay: calc(var(--k) * -0.7s); transform-box: fill-box; }
    @keyframes twinkle { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
    .door { animation: rise 1.6s var(--ease) both; }
    @keyframes rise { from { opacity: 0; transform: translateY(20px) scale(0.98); } }
  }

  .hero h1 {
    font-size: var(--step-5);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 0.9;
    margin-top: 0.8rem;
  }
  .hero .subtitle { margin-top: 1rem; font-family: var(--font-display); font-size: var(--step-2); font-style: italic; color: var(--gold-ink); line-height: 1.2; }
  .blessing { margin-top: 2rem; max-width: 34rem; padding-left: 1.2rem; border-left: 1px solid var(--gold); }
  .blessing p { font-size: var(--step-1); line-height: 1.45; font-style: italic; }
  .blessing footer, .outline footer { margin-top: 0.6rem; font-size: var(--step--1); font-variant-caps: all-small-caps; letter-spacing: 0.14em; color: var(--ink-3); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.8rem; margin-top: 2.4rem; }
  .continue {
    display: inline-grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.6rem;
    max-width: 30rem;
    padding: 0.8rem 1.1rem 0.85rem 0.95rem;
    border: 1px solid var(--hairline);
    border-radius: 16px;
    background: color-mix(in oklab, var(--paper) 80%, transparent);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.3s, box-shadow 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .continue[hidden] { display: none; }
  .continue:hover { border-color: var(--hairline-2); box-shadow: var(--shadow-1); transform: translateY(-1px); color: var(--ink); }
  .continue .mark { width: 0.7rem; height: 0.7rem; background: var(--gold); clip-path: polygon(50% 0, 58% 42%, 100% 50%, 58% 58%, 50% 100%, 42% 58%, 0 50%, 42% 42%); }
  .continue .cw { display: grid; min-width: 0; }
  .continue .eyebrow { font-size: 0.8rem; }
  .continue .what { font-family: var(--font-display); font-size: 1.35rem; line-height: 1.15; }
  .continue .where { font-size: 0.9rem; color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .continue .go { color: var(--gold-ink); transition: transform 0.3s var(--ease); }
  .continue:hover .go { transform: translateX(3px); }
  .text-link { font-size: var(--step--1); font-variant-caps: all-small-caps; letter-spacing: 0.14em; font-weight: 500; color: var(--ink-2); text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 0.45em; }

  /* ── Numbers ───────────────────────────────────────────────────────────── */
  .numbers { border-bottom: 1px solid var(--hairline); background: var(--paper); }
  .numbers dl {
    max-width: 84rem;
    margin: 0 auto;
    padding: clamp(1.6rem, 4vw, 2.6rem) var(--gutter);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 44rem) { .numbers dl { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .numbers div { display: flex; flex-direction: column-reverse; gap: 0.2rem; }
  .numbers dd { font-family: var(--font-display); font-size: var(--step-3); line-height: 1; font-weight: 400; font-variant-numeric: lining-nums; }
  .numbers dt { font-size: var(--step--1); font-variant-caps: all-small-caps; letter-spacing: 0.14em; color: var(--ink-3); }

  /* ── Chapters ──────────────────────────────────────────────────────────── */
  .chapters { max-width: 84rem; margin: 0 auto; padding: clamp(4rem, 9vw, 8rem) var(--gutter) 0; scroll-margin-top: var(--header-h); }
  .chapters-head { text-align: center; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .chapters-head h2 { font-size: var(--step-4); font-weight: 300; }
  .chapters-head p { margin-top: 0.7rem; color: var(--ink-2); font-size: var(--step-1); font-style: italic; }

  .feature {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.4rem);
    padding: clamp(1.4rem, 3.5vw, 2.6rem);
    border-radius: 22px;
    background:
      radial-gradient(80% 140% at 0% 0%, color-mix(in oklab, var(--gold-light) 35%, transparent), transparent 60%),
      var(--ink);
    color: var(--vellum);
    text-decoration: none;
    box-shadow: var(--shadow-2);
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  .feature:hover { transform: translateY(-3px); color: var(--vellum); box-shadow: 0 30px 80px -20px rgb(22 20 15 / 0.45); }
  .feature .f-num { color: var(--gold-light); }
  .feature .f-words { display: grid; gap: 0.35rem; }
  .feature .eyebrow { color: var(--gold-light); }
  .feature .f-title { font-family: var(--font-display); font-size: var(--step-3); line-height: 1.04; font-weight: 400; text-wrap: balance; }
  .feature .f-desc { color: rgb(247 244 238 / 0.82); font-size: var(--step-0); max-width: 44rem; }
  .feature .f-meta { color: rgb(247 244 238 / 0.6); font-size: var(--step--1); font-variant-numeric: lining-nums; }
  .feature .f-go { font-size: 2rem; color: var(--gold-light); transition: transform 0.4s var(--ease); }
  .feature:hover .f-go { transform: translateX(4px); }
  @media (max-width: 44rem) { .feature { grid-template-columns: minmax(0, 1fr); } .feature .f-go { display: none; } }

  .outline { max-width: 46rem; margin: clamp(4rem, 8vw, 6.5rem) auto 0; text-align: center; }
  .outline blockquote p { margin-top: 0.8rem; font-family: var(--font-display); font-size: var(--step-2); line-height: 1.25; font-style: italic; }

  .part { margin-top: clamp(4rem, 8vw, 6.5rem); }
  .part-head { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: baseline; gap: 1.2rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--ink); }
  .part-num { font-family: var(--font-display); font-size: var(--step-4); font-weight: 300; line-height: 0.8; color: var(--gold-ink); }
  .part-head h3 { font-size: var(--step-3); font-weight: 400; font-style: italic; }

  .group { margin-top: clamp(2rem, 4vw, 3rem); }
  .group-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 600;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.15em;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .swatch { width: 10px; height: 10px; transform: rotate(45deg); background: var(--accent); }
  .range { color: var(--ink-3); font-weight: 500; }
  .range::before { content: '·'; margin-right: 0.8rem; color: var(--hairline-2); }

  .cards { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: clamp(0.8rem, 1.8vw, 1.3rem); }
  .card {
    position: relative;
    display: grid;
    gap: 0.35rem;
    height: 100%;
    padding: 1.5rem 1.5rem 1.3rem;
    border: 1px solid var(--hairline);
    border-radius: 18px;
    background: var(--paper);
    text-decoration: none;
    color: var(--ink);
    overflow: hidden;
    transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease), border-color 0.45s;
  }
  .card::after { content: ''; position: absolute; inset: auto 0 0 0; height: 3px; background: var(--accent); transform: scaleX(0); transform-origin: 0 50%; transition: transform 0.5s var(--ease); }
  .card:hover { transform: translateY(-3px); box-shadow: var(--shadow-2); border-color: var(--hairline-2); color: var(--ink); }
  .card:hover::after { transform: scaleX(1); }
  .c-num { position: absolute; right: 1.1rem; top: 0.4rem; font-family: var(--font-display); font-size: 4.6rem; font-weight: 300; line-height: 1; color: color-mix(in oklab, var(--accent) 22%, transparent); font-variant-numeric: lining-nums; transition: color 0.45s; }
  .card:hover .c-num { color: color-mix(in oklab, var(--accent) 45%, transparent); }
  .c-ref { font-size: var(--step--1); font-variant-caps: all-small-caps; letter-spacing: 0.14em; color: var(--accent); font-weight: 600; }
  .c-title { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.05; font-weight: 500; padding-right: 3.6rem; text-wrap: balance; }
  .c-desc { color: var(--ink-2); font-size: 1.02rem; line-height: 1.45; }
  .c-meta { margin-top: auto; padding-top: 0.5rem; font-size: 0.88rem; color: var(--ink-3); font-variant-numeric: lining-nums; }

  /* ── About ─────────────────────────────────────────────────────────────── */
  .about { margin-top: clamp(5rem, 10vw, 8rem); }
  .about-inner { max-width: 46rem; margin: 0 auto; padding: 0 var(--gutter); text-align: center; }
  .about h2 { font-size: var(--step-3); font-weight: 400; margin-top: 0.8rem; }
  .from-study { margin: 1.4rem 0 1.6rem; font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); }

  /* Wide screens: the group's name beside its chapters. */
  @media (min-width: 62rem) {
    .group { display: grid; grid-template-columns: 15rem minmax(0, 1fr); gap: 2.5rem; align-items: start; padding-top: 1.6rem; border-top: 1px solid var(--hairline); }
    .part-head + .group { border-top: 0; }
    .group-title { flex-direction: column; align-items: flex-start; gap: 0.5rem; position: sticky; top: calc(var(--header-h) + 1.5rem); margin: 0.4rem 0 0; font-size: 1.02rem; }
    .group-title .range::before { content: none; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
